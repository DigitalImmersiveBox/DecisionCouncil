<Window x:Class="DecisionCouncil.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DecisionCouncil.App.ViewModels"
        xmlns:views="clr-namespace:DecisionCouncil.App.Views"
        xmlns:controls="clr-namespace:DecisionCouncil.App.Controls"
        Title="Decision Council" Icon="Assets/app.ico" Width="1360" Height="860" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg.Window}" Foreground="{StaticResource Text.Primary}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:NewIdeaViewModel}"><views:NewIdeaView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:LiveDebateViewModel}"><views:LiveDebateView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ResultViewModel}"><views:ResultView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:JournalViewModel}"><views:JournalView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AgentsViewModel}"><views:AgentsView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ContextViewModel}"><views:ContextView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:MessagePageViewModel}">
      <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,60">
          <controls:CouncilAvatar Avatar="dib" AgentId="synthesizer" Color="#D97757" PixelSize="6" ShowExtras="False"
                                  HorizontalAlignment="Center" Margin="0,0,0,18"/>
          <TextBlock Text="{Binding Title}" Style="{StaticResource Title}" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding Message}" Style="{StaticResource Subtitle}" TextAlignment="Center" MaxWidth="420"/>
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <DockPanel Background="{StaticResource Bg.Window}">
    <!-- Header: name and summary on the left, provider and usage, then actions -->
    <Border DockPanel.Dock="Top" Padding="16,12,10,12" BorderBrush="{StaticResource Line.Divider}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="New idea" Click="NewIdea_Click"/>
          <Button Style="{StaticResource IconButton}" Content="&#xE8B7;" ToolTip="Open the data folder: agents, prompts, context and database" Click="DataFolder_Click"/>
          <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Click="Settings_Click"/>
        </StackPanel>

        <!-- Provider and this month's usage, beside the buttons -->
        <Border DockPanel.Dock="Right" Width="230" Margin="12,1,12,0" Padding="14,0,0,0"
                BorderBrush="{StaticResource Line.Divider}" BorderThickness="1,0,0,0" VerticalAlignment="Top">
          <StackPanel>
            <TextBlock TextTrimming="CharacterEllipsis">
              <Run Text="PROVIDER" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Label}"/>
              <Run Text="{Binding ProviderText, Mode=OneWay}" FontSize="11.5" Foreground="{StaticResource Text.Secondary}"/>
            </TextBlock>
            <TextBlock TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                       ToolTip="This month's real calls, estimated at API prices as Claude Code reports them. Signed in with a Claude plan (Pro, Max), they aren't charged: they count against your plan's usage limits.">
              <Run Text="MONTH" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Label}"/>
              <Run Text="{Binding UsageText, Mode=OneWay}" FontSize="11.5" Foreground="{StaticResource Text.Secondary}"/>
            </TextBlock>
            <ProgressBar Height="4" Maximum="100" Value="{Binding UsagePercent, Mode=OneWay}" Margin="0,5,0,0"
                         Visibility="{Binding HasLimit, Converter={StaticResource VisibleWhen}}"/>
          </StackPanel>
        </Border>

        <!-- The dib mascot: idles, and thinks while a debate runs -->
        <controls:CouncilAvatar DockPanel.Dock="Left" Avatar="dib" AgentId="synthesizer" Color="#D97757" PixelSize="2"
                                State="{Binding MascotState}" Margin="-4,-8,8,-4" VerticalAlignment="Center"/>
        <StackPanel>
          <TextBlock Text="Decision Council" Style="{StaticResource Title}"/>
          <StackPanel Orientation="Horizontal" Margin="0,3,0,0" TextElement.FontSize="12" TextElement.Foreground="{StaticResource Text.Secondary}">
            <TextBlock Visibility="{Binding DueText, Converter={StaticResource VisibleWhen}}" Margin="0,0,10,0">
              <Run Text="●" Foreground="{StaticResource Status.NeedsYou}"/>
              <Run Text="{Binding DueText, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Margin="0,0,10,0">
              <Run Text="●" Foreground="{StaticResource Status.Working}"/>
              <Run Text="{Binding DebatesText, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock>
              <Run Text="●" Foreground="{StaticResource Status.Done}"/>
              <Run Text="{Binding ModeText, Mode=OneWay}"/>
            </TextBlock>
          </StackPanel>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Update banner: a new release, its download, or "just updated" -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Bg.Banner}" Padding="16,7,10,7"
            BorderBrush="{StaticResource Line.Divider}" BorderThickness="0,0,0,1"
            Visibility="{Binding ShowUpdateBanner, Converter={StaticResource VisibleWhen}}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="What's new" Style="{StaticResource LinkButton}" Command="{Binding ReleaseNotesCommand}"/>
          <Button Content="Update now" Style="{StaticResource PrimaryButton}" Command="{Binding UpdateNowCommand}"
                  Visibility="{Binding CanUpdateNow, Converter={StaticResource VisibleWhen}}"/>
          <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" ToolTip="Hide until the next release"
                  Command="{Binding DismissUpdateCommand}"/>
        </StackPanel>
        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
          <Run Text="●" Foreground="{StaticResource Accent.PrimaryLight}"/>
          <Run Text="{Binding UpdateBannerText, Mode=OneWay}"/>
        </TextBlock>
      </DockPanel>
    </Border>

    <!-- Credits: dib logo and maker line, bottom-left -->
    <Border DockPanel.Dock="Bottom" Padding="16,6,16,7" BorderBrush="{StaticResource Line.Divider}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal">
        <Path Height="11" Stretch="Uniform" Fill="#8A8D96" VerticalAlignment="Center" Data="{StaticResource DibLogo}"/>
        <TextBlock Text="made by Digital Immersive Box" FontSize="11" Foreground="{StaticResource Text.Label}"
                   Margin="8,0,0,1" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Left panel -->
    <Border DockPanel.Dock="Left" Width="220" Background="{StaticResource Bg.Panel}"
            BorderBrush="{StaticResource Line.Divider}" BorderThickness="0,0,1,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="COUNCIL" Style="{StaticResource Heading}" Margin="16,14,12,6"/>
        <ListBox ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource NavItem}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Badge}" FontSize="11" Foreground="{StaticResource Text.Label}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="{StaticResource Font.Icons}" FontSize="14"
                           Width="18" Margin="0,0,9,0" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Page -->
    <controls:PageHost Content="{Binding CurrentPage}" Focusable="False"/>
  </DockPanel>
</Window>
