<!--
  dib dark theme for WPF apps by Digital Immersive Box.
  Taken from Session Deck (Claude_Helper) so every dib desktop app looks the same; see docs/UI-GUIDELINES.md.
  Self-contained: copy this file into another WPF app and merge it in App.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Surfaces ===== -->
  <SolidColorBrush x:Key="Bg.Window" Color="#141518"/>
  <SolidColorBrush x:Key="Bg.Panel" Color="#121316"/>
  <SolidColorBrush x:Key="Bg.Banner" Color="#17181C"/>
  <SolidColorBrush x:Key="Bg.Card" Color="#1D1F24"/>
  <SolidColorBrush x:Key="Bg.CardHover" Color="#23262C"/>
  <SolidColorBrush x:Key="Bg.Dialog" Color="#1E1F23"/>
  <SolidColorBrush x:Key="Bg.Input" Color="#141518"/>
  <SolidColorBrush x:Key="Bg.Button" Color="#2C2D33"/>
  <SolidColorBrush x:Key="Bg.Hover" Color="#24262B"/>
  <SolidColorBrush x:Key="Bg.Pressed" Color="#30333A"/>
  <SolidColorBrush x:Key="Bg.Checked" Color="#3A3D45"/>
  <SolidColorBrush x:Key="Bg.Selected" Color="#24324A"/>
  <SolidColorBrush x:Key="Bg.Tag" Color="#262930"/>

  <!-- ===== Lines ===== -->
  <SolidColorBrush x:Key="Line.Divider" Color="#22252A"/>
  <SolidColorBrush x:Key="Line.Card" Color="#292C33"/>
  <SolidColorBrush x:Key="Line.CardHover" Color="#3A3E47"/>
  <SolidColorBrush x:Key="Line.Input" Color="#3A3D45"/>
  <SolidColorBrush x:Key="Line.InputHover" Color="#4A4E58"/>
  <SolidColorBrush x:Key="Line.Tag" Color="#30343C"/>
  <SolidColorBrush x:Key="Line.Section" Color="#2C2F36"/>

  <!-- ===== Text ===== -->
  <SolidColorBrush x:Key="Text.Primary" Color="#E6E7EA"/>
  <SolidColorBrush x:Key="Text.Body" Color="#D9DBE0"/>
  <SolidColorBrush x:Key="Text.Soft" Color="#C9CACF"/>
  <SolidColorBrush x:Key="Text.Secondary" Color="#A9ACB4"/>
  <SolidColorBrush x:Key="Text.Meta" Color="#9A9DA6"/>
  <SolidColorBrush x:Key="Text.Label" Color="#7D808A"/>
  <SolidColorBrush x:Key="Text.Faint" Color="#6E717B"/>
  <SolidColorBrush x:Key="Text.OnStatus" Color="#111215"/>

  <!-- ===== Accents ===== -->
  <!-- Claude orange: the one primary action per view, and "selected" outlines -->
  <SolidColorBrush x:Key="Accent.Primary" Color="#C15F3C"/>
  <SolidColorBrush x:Key="Accent.PrimaryLight" Color="#D97757"/>
  <!-- Blue: links, focus, "working" -->
  <SolidColorBrush x:Key="Accent.Link" Color="#60A5FA"/>

  <!-- ===== Status (stripes, chips, dots, bars) ===== -->
  <SolidColorBrush x:Key="Status.NeedsYou" Color="#FF7A59"/>
  <SolidColorBrush x:Key="Status.Check" Color="#F5B83D"/>
  <SolidColorBrush x:Key="Status.Good" Color="#4ADE80"/>
  <SolidColorBrush x:Key="Status.Working" Color="#60A5FA"/>
  <SolidColorBrush x:Key="Status.Done" Color="#6B707B"/>
  <SolidColorBrush x:Key="Status.Idle" Color="#4A4E57"/>

  <!-- ===== Bars ===== -->
  <SolidColorBrush x:Key="Bar.Track" Color="#33363D"/>
  <SolidColorBrush x:Key="Bar.Fill" Color="#C9CACF"/>

  <!-- ===== Fonts ===== -->
  <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
  <FontFamily x:Key="Font.Figure">Segoe UI Light</FontFamily>

