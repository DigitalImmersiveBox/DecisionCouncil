<UserControl x:Class="DecisionCouncil.App.Views.AgentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DecisionCouncil.App.Controls">
  <DockPanel Margin="20,16,20,16">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="Open folder" Command="{Binding OpenFolderCommand}"/>
          <Button Content="New agent" Style="{StaticResource PrimaryButton}" Command="{Binding NewAgentCommand}"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Agents" Style="{StaticResource Title}"/>
          <TextBlock Style="{StaticResource Subtitle}"
                     Text="Each agent is one Markdown file: the front matter sets its name, colour and word limit, the body is its instructions. Shared prompts apply to every agent."/>
        </StackPanel>
      </DockPanel>
      <Border Style="{StaticResource Callout}" BorderBrush="{StaticResource Status.NeedsYou}" Margin="0,12,0,0"
              Visibility="{Binding LoadErrors, Converter={StaticResource VisibleWhen}}">
        <TextBlock Text="{Binding LoadErrors}" TextWrapping="Wrap" Foreground="{StaticResource Text.Body}"/>
      </Border>
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" Padding="6">
        <ListBox ItemsSource="{Binding FilesView}" SelectedItem="{Binding Selected}">
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name, Converter={x:Static controls:UpperCase.Instance}}" Style="{StaticResource Heading}" Margin="10,8,0,2"/>
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsEnabled}" ToolTip="Enabled: appears on the New idea screen"
                          Visibility="{Binding IsAgent, Converter={StaticResource VisibleWhen}}" VerticalAlignment="Center"/>
                <controls:CouncilAvatar DockPanel.Dock="Left" Avatar="{Binding Avatar}" AgentId="{Binding AgentId}" Color="{Binding Color}"
                                        State="{Binding AvatarState}" PixelSize="2" ShowExtras="False" Margin="-4,-4,6,0"
                                        VerticalAlignment="Center" Visibility="{Binding IsAgent, Converter={StaticResource VisibleWhen}}"/>
                <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Margin="0,1,10,1"
                        Background="{Binding Color, Converter={StaticResource HexBrush}}"
                        Visibility="{Binding IsAgent, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"/>
                <StackPanel>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="{StaticResource Text.Faint}"/>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="3*"/>
          <RowDefinition Height="12"/>
          <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="0">
          <DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="14,10">
              <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Status.Check}"
                         Visibility="{Binding IsDirty, Converter={StaticResource VisibleWhen}}">
                <Run Text="●"/>
                <Run Text="unsaved changes"/>
              </TextBlock>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Reset to default" Command="{Binding ResetCommand}"/>
                <Button Content="Revert" Command="{Binding RevertCommand}"/>
                <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
              </StackPanel>
            </DockPanel>
            <TextBox Style="{StaticResource CodeEditor}" BorderThickness="0,0,0,1" Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}"/>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent"/>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="Cancel" Style="{StaticResource DangerButton}" Command="{Binding CancelTestCommand}"
                          Visibility="{Binding IsTesting, Converter={StaticResource VisibleWhen}}"/>
                  <Button Content="Test run" Style="{StaticResource PrimaryButton}" Command="{Binding TestRunCommand}"/>
                </StackPanel>
                <StackPanel>
                  <TextBlock Text="TEST THIS AGENT ALONE" Style="{StaticResource Heading}" Margin="0,0,0,2"/>
                  <TextBlock Text="{Binding ProviderNote}" Style="{StaticResource Hint}"/>
                </StackPanel>
              </DockPanel>
              <TextBox Text="{Binding TestIdea, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MultiLine}" Height="52" Margin="0,10,0,10"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <controls:MarkdownView Markdown="{Binding TestOutput}"/>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</UserControl>
