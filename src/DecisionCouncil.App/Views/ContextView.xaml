<UserControl x:Class="DecisionCouncil.App.Views.ContextView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="20,16,20,16">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="My context" Style="{StaticResource Title}"/>
      <TextBlock Style="{StaticResource Subtitle}"
                 Text="Your business, current projects, constraints and goals. It is sent to every agent in every debate and does more for answer quality than anything else. It stays on your PC except when sent with a debate."/>
    </StackPanel>
    <Border Style="{StaticResource Card}" Padding="0">
      <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="14,10">
          <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Meta}" TextTrimming="CharacterEllipsis">
            <Run Text="{Binding WordCount, Mode=OneWay}"/>
            <Run Text="·"/>
            <Run Text="{Binding FilePath, Mode=OneWay}"/>
          </TextBlock>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Status.Check}" Margin="0,0,6,0"
                       Visibility="{Binding IsDirty, Converter={StaticResource VisibleWhen}}">
              <Run Text="●"/>
              <Run Text="unsaved changes"/>
            </TextBlock>
            <Button Content="Reset to template" Command="{Binding ResetCommand}"/>
            <Button Content="Revert" Command="{Binding RevertCommand}"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
          </StackPanel>
        </DockPanel>
        <TextBox Style="{StaticResource CodeEditor}" BorderThickness="0,0,0,1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
      </DockPanel>
    </Border>
  </DockPanel>
</UserControl>
