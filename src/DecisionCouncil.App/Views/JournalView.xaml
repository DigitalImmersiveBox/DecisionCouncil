<UserControl x:Class="DecisionCouncil.App.Views.JournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DecisionCouncil.App.Controls">
  <DockPanel Margin="20,16,20,16">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock Text="Journal" Style="{StaticResource Title}"/>
      <TextBlock Style="{StaticResource Subtitle}"
                 Text="Every debate, what you decided, and what actually happened. Logging outcomes shows over time which agents earn their place on the panel."/>
      <Border Style="{StaticResource Callout}" BorderBrush="{StaticResource Status.NeedsYou}" Margin="0,12,0,0"
              Visibility="{Binding DueCount, Converter={StaticResource VisibleWhen}}">
        <TextBlock Text="{Binding DueText}" FontWeight="SemiBold"/>
      </Border>
      <TextBlock Text="{Binding TrackRecord}" Style="{StaticResource Hint}" Margin="0,10,0,0"
                 Visibility="{Binding TrackRecord, Converter={StaticResource VisibleWhen}}"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,80,0,0"
                Visibility="{Binding HasItems, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
      <controls:CouncilAvatar Avatar="dib" AgentId="synthesizer" Color="#D97757" PixelSize="5" ShowExtras="False"
                              State="Skipped" HorizontalAlignment="Center" Margin="0,0,0,14"/>
      <TextBlock Text="No debates yet. Start one from New idea." Foreground="{StaticResource Text.Faint}" HorizontalAlignment="Center"/>
    </StackPanel>

    <Grid Visibility="{Binding HasItems, Converter={StaticResource VisibleWhen}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" MinWidth="320"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="3*"/>
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}" Padding="6">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="DEBATES" Style="{StaticResource Heading}" Margin="10,6,0,4"/>
          <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Revisit}" Style="{StaticResource Meta}" Margin="8,0,0,0"/>
                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text.Meta}" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding Date, Mode=OneWay}"/>
                      <Run Text="·"/>
                      <Run Text="{Binding StatusText, Mode=OneWay}"/>
                    </TextBlock>
                  </DockPanel>
                  <DockPanel Margin="0,5,0,0">
                    <Border Style="{StaticResource Chip}" Background="{Binding StateColor, Converter={StaticResource HexBrush}}">
                      <TextBlock Text="{Binding StateText}"/>
                    </Border>
                    <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" Margin="6,0,0,0"
                            Visibility="{Binding IsSimulated, Converter={StaticResource VisibleWhen}}">
                      <TextBlock Text="demo"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                  <TextBlock Text="{Binding Decision}" FontSize="12" Foreground="{StaticResource Text.Secondary}" Margin="0,5,0,0"
                             Visibility="{Binding HasDecision, Converter={StaticResource VisibleWhen}}"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14" Visibility="{Binding HasSelection, Converter={StaticResource VisibleWhen}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <DockPanel Margin="0,0,0,6">
              <Button DockPanel.Dock="Right" Content="Open debate" Style="{StaticResource PrimaryButton}" Command="{Binding OpenCommand}" VerticalAlignment="Top"/>
              <TextBlock Text="{Binding Selected.Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="{Binding IdeaText}" Style="{StaticResource Hint}" FontSize="12"/>

            <Border Style="{StaticResource Divider}"/>
            <TextBlock Text="DECISION" Style="{StaticResource Heading}"/>
            <controls:MarkdownView Markdown="{Binding DecisionText}" Visibility="{Binding HasDecision, Converter={StaticResource VisibleWhen}}"/>
            <TextBlock Text="No decision recorded. Open the debate and press Record my decision." Style="{StaticResource Hint}"
                       Visibility="{Binding HasDecision, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"/>

            <StackPanel Visibility="{Binding HasDecision, Converter={StaticResource VisibleWhen}}">
              <Border Style="{StaticResource Divider}"/>
              <TextBlock Text="WHAT ACTUALLY HAPPENED" Style="{StaticResource Heading}"/>
              <TextBlock Text="{Binding OutcomeLoggedText}" Style="{StaticResource Hint}" Margin="0,0,0,6"
                         Visibility="{Binding OutcomeLoggedText, Converter={StaticResource VisibleWhen}}"/>
              <TextBox Style="{StaticResource MultiLine}" Height="100" Text="{Binding Outcome, UpdateSourceTrigger=PropertyChanged}"/>
              <TextBlock Text="WHICH AGENTS' WARNINGS CAME TRUE?" Style="{StaticResource Heading}" Margin="0,14,0,8"/>
              <ItemsControl ItemsSource="{Binding Warnings}" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,0,18,8"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="Save outcome" Style="{StaticResource PrimaryButton}" Command="{Binding SaveOutcomeCommand}"
                      HorizontalAlignment="Right" Margin="0,6,0,0"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
