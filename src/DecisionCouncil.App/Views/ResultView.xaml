<UserControl x:Class="DecisionCouncil.App.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DecisionCouncil.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20,16,20,24" MaxWidth="1100" HorizontalAlignment="Left">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="Back to journal" Command="{Binding BackCommand}"/>
          <Button Content="Export Markdown" Command="{Binding ExportCommand}"/>
          <Button Content="Record my decision" Style="{StaticResource PrimaryButton}" Command="{Binding OpenDecisionFormCommand}"
                  Visibility="{Binding HasDecision, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"/>
          <Button Content="Edit decision" Command="{Binding OpenDecisionFormCommand}"
                  Visibility="{Binding HasDecision, Converter={StaticResource VisibleWhen}}"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource Title}" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Subtitle}"/>
        </StackPanel>
      </DockPanel>

      <Border Style="{StaticResource Callout}" Margin="0,12,0,0" Visibility="{Binding StatusText, Converter={StaticResource VisibleWhen}}">
        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{StaticResource Text.Body}"/>
      </Border>

      <!-- Decision taken -->
      <Border Style="{StaticResource Callout}" BorderBrush="{StaticResource Status.Good}" Padding="14,10" Margin="0,12,0,0"
              Visibility="{Binding HasDecision, Converter={StaticResource VisibleWhen}}">
        <StackPanel>
          <TextBlock Text="MY DECISION" Style="{StaticResource Heading}" Margin="0,0,0,4"/>
          <TextBlock Text="{Binding DecisionSummary}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Decision.Reason}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource Text.Body}"
                     Visibility="{Binding Decision.Reason, Converter={StaticResource VisibleWhen}}"/>
        </StackPanel>
      </Border>

      <!-- Decision form -->
      <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,14" BorderBrush="{StaticResource Accent.PrimaryLight}" BorderThickness="1.5"
              Visibility="{Binding IsDecisionFormOpen, Converter={StaticResource VisibleWhen}}">
        <StackPanel>
          <TextBlock Text="RECORD MY DECISION" Style="{StaticResource Heading}" Margin="0,0,0,2"/>
          <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                     Text="The council does not decide for you. Write what you decided and why, and when to check what actually happened."/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="260"/>
              <ColumnDefinition Width="20"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="DECISION" Style="{StaticResource Heading}"/>
              <ComboBox IsEditable="True" ItemsSource="{Binding ChoiceOptions}" Text="{Binding Choice, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="REVISIT" Style="{StaticResource Heading}"/>
              <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource SegmentHost}">
                  <StackPanel Orientation="Horizontal">
                    <Button Content="1 month" Style="{StaticResource ChipToggle}" Command="{Binding SetRevisitCommand}" CommandParameter="1"/>
                    <Button Content="3 months" Style="{StaticResource ChipToggle}" Command="{Binding SetRevisitCommand}" CommandParameter="3"/>
                    <Button Content="6 months" Style="{StaticResource ChipToggle}" Command="{Binding SetRevisitCommand}" CommandParameter="6"/>
                    <Button Content="1 year" Style="{StaticResource ChipToggle}" Command="{Binding SetRevisitCommand}" CommandParameter="12"/>
                    <Button Content="None" Style="{StaticResource ChipToggle}" Command="{Binding SetRevisitCommand}" CommandParameter="0"/>
                  </StackPanel>
                </Border>
                <TextBlock Text="{Binding RevisitText}" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </Grid>
          <TextBlock Text="WHY" Style="{StaticResource Heading}" Margin="0,14,0,6"/>
          <TextBox Style="{StaticResource MultiLine}" Height="90" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Command="{Binding CancelDecisionCommand}"/>
            <Button Content="Save decision" Style="{StaticResource PrimaryButton}" Command="{Binding SaveDecisionCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Synthesis -->
      <Border Style="{StaticResource Card}" Padding="0" Margin="0,12,0,0" Visibility="{Binding HasSynthesis, Converter={StaticResource VisibleWhen}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Border Width="4" CornerRadius="7,0,0,7" Background="{StaticResource Accent.Primary}"/>
          <StackPanel Grid.Column="1" Margin="18,14,18,16">
            <DockPanel Margin="0,0,0,8">
              <TextBlock DockPanel.Dock="Right" Text="no verdict, by design" Style="{StaticResource Meta}" VerticalAlignment="Center"/>
              <TextBlock Text="SYNTHESIS" Style="{StaticResource Heading}" Margin="0"/>
            </DockPanel>
            <controls:MarkdownView Markdown="{Binding Synthesis}" FontSize="13.5"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- The idea -->
      <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <Expander Padding="20,8,0,2">
          <Expander.Header>
            <TextBlock Text="THE IDEA AS GIVEN TO THE COUNCIL" Style="{StaticResource Heading}" Margin="0"/>
          </Expander.Header>
          <StackPanel>
            <TextBlock Text="{Binding IdeaText}" TextWrapping="Wrap" Foreground="{StaticResource Text.Body}"/>
            <TextBlock Text="EXTRA CONTEXT" Style="{StaticResource Heading}" Margin="0,12,0,4"
                       Visibility="{Binding ExtraContext, Converter={StaticResource VisibleWhen}}"/>
            <TextBlock Text="{Binding ExtraContext}" TextWrapping="Wrap" Foreground="{StaticResource Text.Body}"
                       Visibility="{Binding ExtraContext, Converter={StaticResource VisibleWhen}}"/>
          </StackPanel>
        </Expander>
      </Border>

      <!-- Agents -->
      <TextBlock Text="EACH AGENT" Style="{StaticResource Heading}" Margin="0,18,0,8"/>
      <ItemsControl ItemsSource="{Binding Agents}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Width="4" CornerRadius="7,0,0,7" Background="{Binding Color, Converter={StaticResource HexBrush}}"/>
                <Expander Grid.Column="1" Margin="14,10,14,10" Padding="20,10,0,4">
                  <Expander.Header>
                    <DockPanel LastChildFill="False">
                      <controls:CouncilAvatar Avatar="{Binding Avatar}" AgentId="{Binding AgentId}" Color="{Binding Color}"
                                              State="{Binding AvatarState}" PixelSize="2" ShowExtras="False" Margin="-4,-6,6,0"
                                              VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Width="190"/>
                      <Border Style="{StaticResource Chip}" Background="{Binding Verdict, Converter={StaticResource VerdictBrush}}"
                              Visibility="{Binding VerdictText, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="{Binding VerdictText}"/>
                      </Border>
                      <Border Style="{StaticResource Tag}" Margin="6,0,0,0" Visibility="{Binding ConfidenceText, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="{Binding ConfidenceText}"/>
                      </Border>
                    </DockPanel>
                  </Expander.Header>
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="ROUND 1 · ALONE" Style="{StaticResource Heading}"/>
                        <controls:MarkdownView Markdown="{Binding Round1Answer}"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="ROUND 2 · CROSS-EXAMINATION" Style="{StaticResource Heading}"/>
                        <controls:MarkdownView Markdown="{Binding Round2Answer}"/>
                        <TextBlock Text="Round 2 did not run." Style="{StaticResource Hint}"
                                   Visibility="{Binding Round2Answer, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"/>
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding MetaText}" Style="{StaticResource Meta}" Margin="0,8,0,0"/>
                    <Expander Margin="0,8,0,0" Padding="0,6,0,0">
                      <Expander.Header>
                        <TextBlock Text="Show the exact round-1 prompt" FontSize="12" Foreground="{StaticResource Text.Secondary}"/>
                      </Expander.Header>
                      <TextBox Text="{Binding PromptText, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource CodeEditor}"
                               MaxHeight="360" FontSize="11.5"/>
                    </Expander>
                  </StackPanel>
                </Expander>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
