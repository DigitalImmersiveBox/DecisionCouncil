<UserControl x:Class="DecisionCouncil.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Laid out like Session Deck's settings: UPPERCASE sections, label and hint on the left, control on the right -->
  <UserControl.Resources>
    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text.Primary}"/>
    </Style>
    <Style x:Key="Row" TargetType="DockPanel">
      <Setter Property="Margin" Value="0,12,0,0"/>
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20,16,20,24" MaxWidth="760" HorizontalAlignment="Left">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Content="Revert" Command="{Binding RevertCommand}"/>
          <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="Settings" Style="{StaticResource Title}"/>
          <TextBlock Style="{StaticResource Subtitle}">
            <Run Text="Saved in"/>
            <Run Text="{Binding SettingsFile, Mode=OneWay}"/>
          </TextBlock>
        </StackPanel>
      </DockPanel>

      <Border Style="{StaticResource Card}" Padding="20,16,20,18" Margin="0,14,0,0">
        <StackPanel>
          <!-- Provider -->
          <TextBlock Text="MODEL PROVIDER" Style="{StaticResource Heading}" Margin="0"/>
          <DockPanel Style="{StaticResource Row}" Margin="0,8,0,0">
            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Segment}" GroupName="provider" Content="Demo" IsChecked="{Binding IsDemoProvider}"/>
                <RadioButton Style="{StaticResource Segment}" GroupName="provider" Content="Claude Code CLI" IsChecked="{Binding IsCliProvider}"/>
              </StackPanel>
            </Border>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="Where answers come from" Style="{StaticResource RowLabel}"/>
              <TextBlock Style="{StaticResource Hint}" Margin="0,1,0,0"
                         Text="Demo: simulated, never uses credit. CLI: your own Claude Code login and plan."/>
            </StackPanel>
          </DockPanel>

          <StackPanel Visibility="{Binding IsCli, Converter={StaticResource VisibleWhen}}">
            <DockPanel Style="{StaticResource Row}">
              <TextBox DockPanel.Dock="Right" Width="300" Text="{Binding ClaudeExecutable, UpdateSourceTrigger=PropertyChanged}"/>
              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Claude Code executable" Style="{StaticResource RowLabel}"/>
                <TextBlock Text="{Binding ResolvedCli}" Style="{StaticResource Hint}" Margin="0,1,0,0"/>
              </StackPanel>
            </DockPanel>
            <DockPanel Style="{StaticResource Row}">
              <TextBox DockPanel.Dock="Right" Width="300" Text="{Binding ClaudeExtraArgs, UpdateSourceTrigger=PropertyChanged}"/>
              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Extra CLI arguments" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,1,0,0"
                           Text="Added after the built-in ones: -p, --output-format json, --tools &quot;&quot;, --strict-mcp-config, --no-session-persistence."/>
              </StackPanel>
            </DockPanel>
            <DockPanel Style="{StaticResource Row}">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Refresh" Command="{Binding RefreshSignInCommand}"/>
                <Button Content="{Binding SignInButtonText}" Command="{Binding SignInCommand}"/>
              </StackPanel>
              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Sign-in" Style="{StaticResource RowLabel}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,1,0,0"
                           Text="Sign in opens a console with `claude auth login`, then your browser. Refresh reads the login state; neither calls a model."/>
                <TextBlock Text="{Binding SignInStatus}" Style="{StaticResource Hint}" Foreground="{StaticResource Text.Primary}" Margin="0,4,0,0"
                           TextWrapping="Wrap" Visibility="{Binding SignInStatus, Converter={StaticResource VisibleWhen}}"/>
              </StackPanel>
            </DockPanel>
          </StackPanel>

          <DockPanel Style="{StaticResource Row}">
            <Button DockPanel.Dock="Right" Content="Check provider" Command="{Binding CheckCommand}" VerticalAlignment="Center"/>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="Check" Style="{StaticResource RowLabel}"/>
              <TextBlock Style="{StaticResource Hint}" Margin="0,1,0,0" Text="Runs only `claude --version`. It never calls a model."/>
              <TextBlock Text="{Binding CheckResult}" Style="{StaticResource Hint}" Foreground="{StaticResource Text.Primary}" Margin="0,4,0,0"
                         Visibility="{Binding CheckResult, Converter={StaticResource VisibleWhen}}"/>
            </StackPanel>
          </DockPanel>

          <Border Style="{StaticResource Divider}"/>

          <!-- Debate -->
          <TextBlock Text="DEBATE" Style="{StaticResource Heading}" Margin="0"/>
          <DockPanel Style="{StaticResource Row}" Margin="0,8,0,0">
            <ComboBox DockPanel.Dock="Right" Width="180" IsEditable="True" ItemsSource="{Binding ModelSuggestions}"
                      Text="{Binding AgentModel, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="Agent model" Style="{StaticResource RowLabel}"/>
              <TextBlock Text="Used for round 1, round 2 and test runs." Style="{StaticResource Hint}" Margin="0,1,0,0"/>
            </StackPanel>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <ComboBox DockPanel.Dock="Right" Width="180" IsEditable="True" ItemsSource="{Binding ModelSuggestions}"
                      Text="{Binding SynthesizerModel, UpdateSourceTrigger=PropertyChanged}"/>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="Synthesizer model" Style="{StaticResource RowLabel}"/>
              <TextBlock Text="One call per debate; the strongest model pays off here." Style="{StaticResource Hint}" Margin="0,1,0,0"/>
            </StackPanel>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <ComboBox DockPanel.Dock="Right" Width="180" IsEditable="True" ItemsSource="{Binding LanguageSuggestions}"
                      Text="{Binding AnswerLanguage, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Answer language" Style="{StaticResource RowLabel}" VerticalAlignment="Center"/>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Segment}" GroupName="round2" Content="On" IsChecked="{Binding Round2Default}"/>
                <RadioButton Style="{StaticResource Segment}" GroupName="round2" Content="Off" IsChecked="{Binding Round2Off}"/>
              </StackPanel>
            </Border>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="Round 2 by default" Style="{StaticResource RowLabel}"/>
              <TextBlock Text="Cross-examination; can still be switched per debate." Style="{StaticResource Hint}" Margin="0,1,0,0"/>
            </StackPanel>
          </DockPanel>
          <DockPanel Style="{StaticResource Row}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <StackPanel Width="80" Margin="8,0,0,0">
                <TextBlock Text="PARALLEL" Style="{StaticResource Heading}" Margin="0,0,0,3"/>
                <TextBox Text="{Binding MaxConcurrency}"/>
              </StackPanel>
              <StackPanel Width="80" Margin="8,0,0,0">
                <TextBlock Text="RETRIES" Style="{StaticResource Heading}" Margin="0,0,0,3"/>
                <TextBox Text="{Binding MaxRetries}"/>
              </StackPanel>
              <StackPanel Width="80" Margin="8,0,0,0">
                <TextBlock Text="TIMEOUT S" Style="{StaticResource Heading}" Margin="0,0,0,3"/>
                <TextBox Text="{Binding CallTimeoutSeconds}"/>
              </StackPanel>
              <StackPanel Width="80" Margin="8,0,0,0">
                <TextBlock Text="DEMO SPEED" Style="{StaticResource Heading}" Margin="0,0,0,3"/>
                <TextBox Text="{Binding DemoSpeed}" ToolTip="1 = realistic delays, higher = faster"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
              <TextBlock Text="Calls" Style="{StaticResource RowLabel}"/>
              <TextBlock Text="About 3 in parallel keeps clear of rate limits." Style="{StaticResource Hint}" Margin="0,1,0,0"/>
            </StackPanel>
          </DockPanel>

          <Border Style="{StaticResource Divider}"/>

          <!-- Usage -->
          <TextBlock Text="USAGE LIMIT" Style="{StaticResource Heading}" Margin="0"/>
          <DockPanel Margin="0,6,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <StackPanel Width="110" Margin="8,0,0,0">
                <TextBlock Text="LIMIT (USD)" Style="{StaticResource Heading}" Margin="0,0,0,3"/>
                <TextBox Text="{Binding MonthlyLimitText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Empty = no limit"/>
              </StackPanel>
              <StackPanel Width="80" Margin="8,0,0,0">
                <TextBlock Text="WARN AT %" Style="{StaticResource Heading}" Margin="0,0,0,3"/>
                <TextBox Text="{Binding WarnAtPercent}"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Margin="-2,-4,0,-4">
                <Run Text="{Binding UsageFigure, Mode=OneWay}" FontFamily="{StaticResource Font.Figure}" FontSize="34"/>
              </TextBlock>
              <TextBlock Text="{Binding UsageDetail}" Style="{StaticResource Hint}"/>
              <ProgressBar Maximum="100" Value="{Binding UsagePercent, Mode=OneWay}" Width="220" HorizontalAlignment="Left" Margin="0,6,0,0"
                           Visibility="{Binding HasLimit, Converter={StaticResource VisibleWhen}}"/>
            </StackPanel>
          </DockPanel>
          <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                     Text="Compared with the cost the CLI reports. The app warns at the warning level and refuses to start calls at the limit. Demo debates never count."/>

          <Border Style="{StaticResource Divider}"/>

          <!-- Data -->
          <TextBlock Text="DATA FOLDER" Style="{StaticResource Heading}" Margin="0"/>
          <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,8"
                     Text="Agents, prompts, your context and the database. Back up by copying this folder. A new folder is used after restarting the app."/>
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Open" Command="{Binding OpenDataFolderCommand}"/>
            <TextBox Text="{Binding DataFolder, UpdateSourceTrigger=PropertyChanged}"/>
          </DockPanel>

          <Border Style="{StaticResource Divider}"/>

          <!-- Updates -->
          <TextBlock Text="UPDATES" Style="{StaticResource Heading}" Margin="0"/>
          <DockPanel Style="{StaticResource Row}" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="What's new" Style="{StaticResource LinkButton}" Command="{Binding ReleaseNotesCommand}"/>
              <Button Content="{Binding UpdateButtonText}" Command="{Binding UpdateCommand}" IsEnabled="{Binding UpdateButtonEnabled}"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="{Binding VersionText}" Style="{StaticResource RowLabel}"/>
              <TextBlock Text="{Binding UpdateNote}" Style="{StaticResource Hint}" Margin="0,1,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
